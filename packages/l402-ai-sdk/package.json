{
  "name": "@lightninglabs/l402-ai",
  "version": "0.2.0",
  "description": "L402 Lightning payment tools for the Vercel AI SDK. Let AI agents pay for APIs with Bitcoin.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf node_modules dist coverage .cache *.tsbuildinfo *.log"
  },
  "keywords": [
    "l402",
    "lightning",
    "bitcoin",
    "ai",
    "vercel",
    "ai-sdk",
    "agent",
    "payments"
  ],
  "packageManager": "yarn@4.18.1",
  "author": "Dario Anongba Varela <dario.anongba@gmail.com>",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lightninglabs/L402sdk.git",
    "directory": "packages/l402-ai-sdk"
  },
  "homepage": "https://github.com/lightninglabs/L402sdk",
  "peerDependencies": {
    "ai": ">=6.0.0",
    "zod": "^3.25.76 || ^4.1.8"
  },
  "dependencies": {
    "@lightninglabs/l402": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ai": "^7.0.155",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "resolutions": {
    "@humanfs/node": "0.16.8",
    "@lightninglabs/l402": "portal:../../crates/l402-wasm/pkg"
  }
}
